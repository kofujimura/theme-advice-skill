# ローカル開発専用。Vercelでは設定せず、Private Blobストアを接続する。
THEME_STORAGE=local
THEME_LOCAL_DATA_DIR=.theme-site-data
PORT=3210

# 先生が設定してゼミ生に別途配布。実際の値をGitHubにコミットしない。
THEME_SUBMIT_TOKEN=replace-with-a-random-key-at-least-24-characters

# VercelではPrivate Blobを接続して BLOB_STORE_ID + OIDC、
# または BLOB_READ_WRITE_TOKEN をサーバー側に設定する。
